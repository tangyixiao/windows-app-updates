<Window x:Class="WindowsAppUpdates.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="应用更新" Width="1080" Height="720" MinWidth="800" MinHeight="530"
        WindowStartupLocation="CenterScreen" Language="zh-CN" FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="14" Foreground="#172821" Background="#F2F5F2" UseLayoutRounding="True"
        Loaded="WindowLoaded" Closing="WindowClosing">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#172821" />
        <SolidColorBrush x:Key="Muted" Color="#486057" />
        <SolidColorBrush x:Key="Line" Color="#DDE6DF" />
        <SolidColorBrush x:Key="Green" Color="#146749" />

        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D3DFD6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.82" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.70" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.48" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource Green}" />
            <Setter Property="BorderBrush" Value="{StaticResource Green}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Navigation" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Tab" Padding="14,8" Background="Transparent" CornerRadius="6">
                            <ContentPresenter RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tab" Property="Background" Value="#E8EFE9" /></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Tab" Property="Background" Value="#DDEDE2" />
                                <Setter Property="Foreground" Value="#14563C" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E9EEE9" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowHeight" Value="55" />
            <Setter Property="ColumnHeaderHeight" Value="36" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="EnableRowVirtualization" Value="True" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="#F1F6F2" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border x:Name="Cell" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Cell" Property="Background" Value="#E9F3EC" /></Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Cell" Property="BorderBrush" Value="#368265" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="Margin" Value="12,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>
    </Window.Resources>

    <Grid Margin="28,22,28,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel LastChildFill="True" Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="来源　WinGet 社区源" VerticalAlignment="Center" Margin="0,0,14,0" Foreground="{StaticResource Muted}" />
                <Button x:Name="RefreshButton" Content="检查更新" Click="RefreshClicked" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="应用更新" FontSize="30" FontWeight="SemiBold" />
                <TextBlock x:Name="LastScan" Text="等待检查" FontSize="12" Foreground="{StaticResource Muted}" Margin="1,4,0,0" />
            </StackPanel>
        </DockPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <RadioButton x:Name="UpdatesTab" Content="可用更新" GroupName="Pages" Style="{StaticResource Navigation}" IsChecked="True" Checked="PageChanged" />
            <RadioButton x:Name="HistoryTab" Content="更新记录" GroupName="Pages" Style="{StaticResource Navigation}" Checked="PageChanged" Margin="4,0,0,0" />
        </StackPanel>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
            <Grid>
                <Grid x:Name="UpdatesPage">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="14,12" LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                            <Button x:Name="SelectVisibleButton" Content="勾选当前结果" Click="SelectVisibleClicked" Margin="0,0,6,0" />
                            <Button x:Name="ClearButton" Content="清空勾选" Click="ClearClicked" />
                        </StackPanel>
                        <DockPanel MaxWidth="440" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Label DockPanel.Dock="Left" Content="搜索" Target="{Binding ElementName=Search}" Padding="0,0,10,0" VerticalAlignment="Center" />
                            <TextBox x:Name="Search" Width="242" Height="36" VerticalContentAlignment="Center" Padding="9,0"
                                     BorderBrush="#CFDCD2" AutomationProperties.Name="按应用名称或包 ID 搜索" TextChanged="SearchChanged" />
                        </DockPanel>
                    </DockPanel>

                    <DataGrid x:Name="UpdatesGrid" Grid.Row="1" IsReadOnly="True" AutomationProperties.Name="可用更新列表">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="48" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  AutomationProperties.Name="{Binding Name}"
                                                  IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="应用" Width="*" MinWidth="225" SortMemberPath="Name">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="12,0" ToolTip="{Binding Name}">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Id}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Muted}" FontSize="12" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="已安装" Binding="{Binding Installed}" ElementStyle="{StaticResource CellText}" Width="150" MinWidth="95" />
                            <DataGridTextColumn Header="可更新至" Binding="{Binding Available}" Width="156" MinWidth="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                                        <Setter Property="Foreground" Value="{StaticResource Green}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="1" x:Name="UpdatesEmpty" Text="正在检查应用更新…" VerticalAlignment="Center" HorizontalAlignment="Center"
                               Foreground="{StaticResource Muted}" IsHitTestVisible="False" />

                    <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="14,11">
                        <DockPanel LastChildFill="True">
                            <Button x:Name="InstallButton" DockPanel.Dock="Right" Content="更新所选" Style="{StaticResource PrimaryButton}" Click="InstallClicked" />
                            <Button x:Name="StopButton" DockPanel.Dock="Right" Content="本项完成后停止" Click="StopClicked" Visibility="Collapsed" Margin="0,0,8,0" />
                            <TextBlock x:Name="SelectionInfo" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
                        </DockPanel>
                    </Border>
                </Grid>

                <Grid x:Name="HistoryPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DataGrid x:Name="HistoryGrid" IsReadOnly="True" RowHeight="42" AutomationProperties.Name="更新记录列表"
                              SelectionChanged="HistorySelectionChanged" MouseDoubleClick="HistoryDoubleClicked">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Binding="{Binding TimeText}" SortMemberPath="Time" ElementStyle="{StaticResource CellText}" Width="104" />
                            <DataGridTextColumn Header="应用" Binding="{Binding Name}" ElementStyle="{StaticResource CellText}" Width="*" MinWidth="170" />
                            <DataGridTextColumn Header="目标版本" Binding="{Binding Available}" ElementStyle="{StaticResource CellText}" Width="150" />
                            <DataGridTextColumn Header="结果" Binding="{Binding Result}" ElementStyle="{StaticResource CellText}" Width="150" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="HistoryEmpty" Text="暂无更新记录" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}" IsHitTestVisible="False" />
                    <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="14,11">
                        <DockPanel>
                            <Button x:Name="HistoryDetailsButton" Content="查看详情" DockPanel.Dock="Right" Click="HistoryDetailsClicked" IsEnabled="False" />
                            <TextBlock Text="本机最近 100 条更新记录" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="1,14,1,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <ProgressBar x:Name="Activity" IsIndeterminate="True" Width="32" Height="4" Foreground="{StaticResource Green}" Margin="0,0,9,0" Visibility="Collapsed" />
                <TextBlock x:Name="Status" Grid.Column="1" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </Grid>
            <Button x:Name="ScanDetailsButton" Grid.Column="1" Content="检查详情" Click="ScanDetailsClicked" MinHeight="28" Padding="10,3" IsEnabled="False" Margin="10,0,0,0" />
        </Grid>
    </Grid>
</Window>
